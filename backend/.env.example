# Application
APP_NAME=Finance Expense Manager
APP_VERSION=1.0.0
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance_db

# Redis (optional - for caching/sessions)
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost"]

# Email Configuration (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
EMAILS_FROM_EMAIL=noreply@financeapp.com
